# --- Cluster RPC endpoints ---
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# --- Keypairs (solana CLI id.json format: a JSON array of bytes) ---
# Mainnet account that holds/pays treasury reserves and the team split.
MAINNET_TREASURY_KEYPAIR=./secrets/treasury-mainnet.json
# Devnet authority allowed to write whitelist state into the platform program.
DEVNET_AUTHORITY_KEYPAIR=./secrets/authority-devnet.json

# --- Wallets ---
# Mainnet pubkey that receives the team split of each activation fee.
TEAM_WALLET=

# --- Fee parameters (basis points; 100 = 1%) ---
ACTIVATION_FEE_BPS=100
REDEMPTION_RATE_BPS=80
TEAM_SPLIT_BPS=2000

# --- Relayer runtime ---
LEDGER_PATH=./ledger.json
POLL_INTERVAL_MS=3000
# Keep true until the on-chain programs exist; false switches to the real Solana adapter.
USE_MOCK_ADAPTER=true
